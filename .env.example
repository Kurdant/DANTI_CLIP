# ============================================================
# Configuration DANTI_CLIPER - Jalon 1 (idee -> script -> voix)
# Copie ce fichier en ".env" et remplis les valeurs.
# ============================================================

# --- Moteur LLM (generation de texte) ---
# mock    -> aucun acces reseau, sortie simulee (pour tester sans rien configurer)
# openai  -> tout provider compatible OpenAI (Groq, Gemini, OpenRouter, ...)
LLM_PROVIDER=mock

# --- Provider compatible OpenAI (si LLM_PROVIDER=openai) ---
# Groq  : baseURL https://api.groq.com/openai/v1  |  cle gratuite sur console.groq.com
# Gemini: baseURL https://generativelanguage.googleapis.com/v1beta/openai/  |  cle AI Studio
# OpenRouter: baseURL https://openrouter.ai/api/v1  |  cle openrouter.ai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Modele Groq dispo en 2026 : openai/gpt-oss-120b est le meilleur pour du contenu createur en FR.
LLM_MODEL=openai/gpt-oss-120b

# --- Synthese vocale (Edge TTS, gratuit et illimite) ---
# Liste de voix FR dispo: `npm run gen -- --voix`
# RemyMultilingual / VivienneMultilingual sont les plus expressives ("drole").
EDGE_VOICE=fr-FR-RemyMultilingualNeural

# --- Azure AI Speech (voix officielle, licence commerciale) ---
# Cree un compte Azure + une ressource "Speech" (region France Central de prefere).
# Si renseignes, Azure est utilise A LA PLACE d'Edge TTS (Edge reste le fallback dev).
# Free tier : 0,5 M caracteres/mois (~550 videos). Cle + region dans le portail Azure.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=francecentral

# --- Google Cloud Text-to-Speech (voix officielle, licence commerciale) ---
# PRIORITAIRE sur Azure. Cree une cle API dans Google Cloud Console
# (APIs & Services -> Credentials -> API Key) apres avoir active "Text-to-Speech API".
# Free tier : 1 M caracteres/mois (~1100 videos). Voix par defaut : en-US-Neural2-D.
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=en-US-Neural2-D

# --- Garde-fou TTS (anti-facturation) ---
# Plafond mensuel de caracteres synthetises (90% du free tier Google par defaut).
# Au-dela, la synthese vocale est bloquee : pas de facturation surprise.
TTS_MONTHLY_LIMIT=900000

# --- Divers ---
# Dossier de sortie des fichiers generes
OUTPUT_DIR=output
# Nombre d'idees a generer a chaque fois
N_IDEES=3
# Langue du contenu
LANGUAGE=fr

# --- Piste B : images d'illustration par partie (Pexels, libre de droits) ---
# Cle gratuite sur https://www.pexels.com/api/ (compte gratuit).
# Vide = piste B desactivee (fond degrade). 200 req/h, 20 000/mois par defaut.
# Couvre les photos ET les clips video (b-roll).
PEXELS_API_KEY=

# --- Musique de fond (piste C) ---
# Dossier des musiques libres de droits (mp3/m4a/wav/ogg).
# La musique est bouclee et automatiquement baissee (ducking) sous la voix.
MUSIC_DIR=assets/music

# --- Sound effects (SFX) ---
# Dossier des effets sonores (whoosh/boom pour l'intro, ding/pop sur les chiffres).
# Nomme les fichiers selon leur role : whoosh_impact.mp3, ding_pop.mp3...
SFX_DIR=assets/sfx

# --- Stats YouTube (vues/likes/commentaires des videos publiques) ---
# Google Cloud Console -> Credentials -> Create API key.
# Necessaire pour les statistiques. Aucun OAuth requis pour les videos publiques.
YOUTUBE_API_KEY=
