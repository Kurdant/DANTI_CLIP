# ============================================================
# Configuration DANTI_CLIPER - Jalon 1 (idee -> script -> voix)
# Copie ce fichier en ".env" et remplis les valeurs.
# ============================================================

# --- Moteur LLM (generation de texte) ---
# mock    -> aucun acces reseau, sortie simulee (pour tester sans rien configurer)
# openai  -> tout provider compatible OpenAI (Groq, Gemini, OpenRouter, ...)
LLM_PROVIDER=mock

# --- Provider compatible OpenAI (si LLM_PROVIDER=openai) ---
# Groq  : baseURL https://api.groq.com/openai/v1  |  cle gratuite sur console.groq.com
# Gemini: baseURL https://generativelanguage.googleapis.com/v1beta/openai/  |  cle AI Studio
# OpenRouter: baseURL https://openrouter.ai/api/v1  |  cle openrouter.ai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Modele Groq dispo en 2026 : openai/gpt-oss-120b est le meilleur pour du contenu createur en FR.
LLM_MODEL=openai/gpt-oss-120b

# --- Synthese vocale (Edge TTS, gratuit et illimite) ---
# Liste de voix FR dispo: `npm run gen -- --voix`
# RemyMultilingual / VivienneMultilingual sont les plus expressives ("drole").
EDGE_VOICE=fr-FR-RemyMultilingualNeural

# --- Divers ---
# Dossier de sortie des fichiers generes
OUTPUT_DIR=output
# Nombre d'idees a generer a chaque fois
N_IDEES=3
# Langue du contenu
LANGUAGE=fr
