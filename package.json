{
  "name": "danticliper",
  "version": "0.1.0",
  "description": "Générateur de Shorts quasi-automatiques : idees -> script -> voix -> (montage -> publication)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "gen": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "server": "tsx server/src/index.ts",
    "server:watch": "tsx watch server/src/index.ts",
    "seed": "tsx server/src/seed-cli.ts"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "edge-tts-universal": "^1.4.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
